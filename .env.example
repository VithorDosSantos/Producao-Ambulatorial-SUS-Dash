# ===================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===================================

# Banco PAPA (Produção SIASUS)
DB_PAPA_HOST=localhost
DB_PAPA_DATABASE=siasus_db
DB_PAPA_USER=postgres
DB_PAPA_PASSWORD=sua_senha_aqui
DB_PAPA_PORT=5432

# Banco ESPELHO (Teto Orçamentário)
DB_ESPELHO_HOST=localhost
DB_ESPELHO_DATABASE=Espelho_siasus
DB_ESPELHO_USER=postgres
DB_ESPELHO_PASSWORD=sua_senha_aqui
DB_ESPELHO_PORT=5432

# ===================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ===================================

# Ambiente (development, production)
ENVIRONMENT=development

# CORS - URLs permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================================
# CONFIGURAÇÕES DO FRONTEND
# ===================================

# URL da API (para produção, use a URL do seu backend no Render)
VITE_API_URL=http://localhost:8000
